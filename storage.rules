rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Blog kapak fotoğrafları — giriş yapmış kullanıcılar yükleyebilir, herkes
    // okuyabilir (recipes/review-photos ile aynı model). Asıl admin sınırı
    // firestore.rules'daki blogPosts.write: isAdmin() kuralında; buradaki
    // dosya bir yazıya bağlanmadan tek başına hiçbir şey ifade etmiyor.
    // NOT: burada isAdmin() firestore.get() ile kontrol edilmeye çalışıldı
    // ama Storage'ın Firestore'a cross-service erişimi bu projede hiç
    // etkinleştirilmemiş (Firebase Console > Storage > Rules'a bir kez
    // girip izni onaylamak gerekiyor) — o yüzden isAdmin() her zaman false
    // dönüp yüklemeyi engelliyordu. Etkinleştirilirse admin kontrolüne
    // geri dönülebilir.
    match /blog/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Tarif fotoğrafları — giriş yapmış kullanıcılar yükleyebilir, herkes okuyabilir.
    // Silme: `write` kuralı request.resource'a baktığı için silmede (resource
    // yok) hep reddediliyordu ve hesap/tarif silinince fotoğraflar yetim
    // kalıyordu. Dosya adında uid olmadığından mobil yükleme customMetadata'ya
    // ownerUid yazıyor; yalnızca o kullanıcı silebilir. Bu alan eklenmeden
    // önce yüklenen dosyalar silinemez (eski davranış, deleteImageByUrl
    // hatayı yutuyor).
    match /recipes/{fileName} {
      allow read: if true;
      allow create: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
                    && resource.metadata.ownerUid == request.auth.uid;
    }

    // Tarif kartı küçük görselleri (480x320) — web admin panelindeki foto
    // yükleme akışı hem tam boy hem de bu thumb'ı yazıyor; bu kural eksikti
    // ve thumb yüklemesi deny-all'a düşüp tüm yüklemeyi (Promise.all) başarısız
    // kılıyordu.
    match /recipes-thumb/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Yorum fotoğrafları (eski) — herkes okuyabilir. Dosya adı `{uid}_{timestamp}.jpg`
    // formatında (bkz. web/src/components/ReviewsSection.tsx) ama burada isim
    // zorunlu kılınmıyor -- asıl güvenlik sınırı `reviews` koleksiyonundaki
    // Firestore kuralları (bkz. firestore.rules: yorum sahibi request.auth.uid
    // ile eşleşmeli).
    match /review-photos/{fileName} {
      allow read: if true;
      // Yorum fotoğrafı özelliği kaldırıldı (yalnızca anonim puan) -- yeni
      // yükleme yok; eski dosyalar sahibince silinebilir.
      allow create, update: if false;
      // Silme: `write` request.resource'a baktığı için silme hep
      // reddediliyordu; hesap silinince yorum fotoğrafları yetim kalıyordu
      // (KVKK md.7). Dosya adı `{uid}_{timestamp}.jpg` -- yalnızca sahibi.
      allow delete: if request.auth != null
                    && fileName.matches(request.auth.uid + '_.*');
    }

    // Diğer her şey yasak
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
