rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Blog kapak fotoğrafları — giriş yapmış kullanıcılar yükleyebilir, herkes
    // okuyabilir (recipes/review-photos ile aynı model). Asıl admin sınırı
    // firestore.rules'daki blogPosts.write: isAdmin() kuralında; buradaki
    // dosya bir yazıya bağlanmadan tek başına hiçbir şey ifade etmiyor.
    // NOT: burada isAdmin() firestore.get() ile kontrol edilmeye çalışıldı
    // ama Storage'ın Firestore'a cross-service erişimi bu projede hiç
    // etkinleştirilmemiş (Firebase Console > Storage > Rules'a bir kez
    // girip izni onaylamak gerekiyor) — o yüzden isAdmin() her zaman false
    // dönüp yüklemeyi engelliyordu. Etkinleştirilirse admin kontrolüne
    // geri dönülebilir.
    match /blog/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Tarif fotoğrafları — giriş yapmış kullanıcılar yükleyebilir, herkes okuyabilir
    match /recipes/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Tarif kartı küçük görselleri (480x320) — web admin panelindeki foto
    // yükleme akışı hem tam boy hem de bu thumb'ı yazıyor; bu kural eksikti
    // ve thumb yüklemesi deny-all'a düşüp tüm yüklemeyi (Promise.all) başarısız
    // kılıyordu.
    match /recipes-thumb/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Yorum fotoğrafları — giriş yapmış kullanıcılar kendi yorumlarına
    // fotoğraf ekleyebilir, herkes okuyabilir. Dosya adı `{uid}_{timestamp}.jpg`
    // formatında (bkz. web/src/components/ReviewsSection.tsx) ama burada isim
    // zorunlu kılınmıyor -- asıl güvenlik sınırı `reviews` koleksiyonundaki
    // Firestore kuralları (bkz. firestore.rules: yorum sahibi request.auth.uid
    // ile eşleşmeli).
    match /review-photos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Diğer her şey yasak
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
